# Unified Next.js app configuration.
# Copy to frontend/.env.local and fill the Supabase Postgres URL.

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
AUTH_SECRET=change-this-local-secret
MSGWAY_API_KEY=<msgway-api-key>
MSGWAY_TEMPLATE_ID=<approved-template-id>
# Optional local-only fixed OTP. Never set this in production.
OTP_DEV_CODE=

# Signup and new-order email alerts (Gmail requires an app password).
SMTP_USER=s.jahanmard@gmail.com
SMTP_PASSWORD=<smtp-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_FROM=s.jahanmard@gmail.com
EMAIL_ALERT_TO=s.jahanmard@gmail.com
WORKER_API_KEY=local-worker-dev-key
STORAGE_DIR=storage

# Leave empty for same-origin API calls from the browser.
NEXT_PUBLIC_API_URL=
# Public, domain-scoped token issued by Cloudflare Web Analytics.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional tuning for Supabase/Postgres connections.
DB_POOL_SIZE=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=30000
WORKER_LOCK_MINUTES=60
MAX_UPLOAD_SIZE_MB=50
